/**
 * Setup.gs — run setupDatabase() ONCE to fill this spreadsheet with the PM Prep tabs.
 * Safe to re-run: it rewrites the Questions/Read_Me tabs and only creates the data tabs if they are missing.
 */
function setupDatabase() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var data = SETUP_DATA_;
  data.forEach(function (pair) {
    var name = pair[0], rows = pair[1];
    var sh = ss.getSheetByName(name);
    var isData = ['Responses','Answers','Sessions','Practice','Flags'].indexOf(name) >= 0;
    if (sh && isData && sh.getLastRow() > 1) return; // never wipe collected data
    if (!sh) sh = ss.insertSheet(name);
    sh.clear();
    rows = rows.map(function (r) { return r.map(function (v) {
      return (typeof v === 'string' && /^[=+\-@]/.test(v)) ? "'" + v : v; }); });
    sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold').setBackground('#F7941D').setFontColor('#FFFFFF');
  });
  ['Sheet1', 'الورقة1'].forEach(function (n) {
    var s = ss.getSheetByName(n);
    if (s && ss.getSheets().length > 1 && s.getLastRow() === 0) ss.deleteSheet(s);
  });
  ss.setActiveSheet(ss.getSheetByName('Questions'));
  return 'Done: ' + (data[1][1].length - 1) + ' questions loaded.';
}

